{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openly-prod",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/index.ts",
  "vars": {
    "APP_ORIGIN": "https://openly.sh",
    "EMAIL_FROM": "Openly <signin@openly.sh>"
  },
  "d1_databases": [
    {
      "binding": "OPENLY",
      "database_name": "openly-db","database_id": "a576b5f6-3460-4bf5-8555-1a888d6872c8"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "PENDING","id": "00c4344b8e8b4107b614f9270fb5ee02"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ]
}
